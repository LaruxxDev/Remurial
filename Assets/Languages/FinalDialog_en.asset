  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FinalDialog_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b196cc271be04d14099b2faf57f59d9f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 18489056276480
    m_Localized: "That hallway seems dark. There is no way I\uFFFDm going inside."
    m_Metadata:
      m_Items: []
  - m_Id: 18489060470785
    m_Localized: File saved successfully!
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665089
    m_Localized: "It\uFFFDs closed."
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665090
    m_Localized: It opened!
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665091
    m_Localized: Needs a key.
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665093
    m_Localized: 'This wall seems really weak. '
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665094
    m_Localized: It broke!
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665096
    m_Localized: There is a hammer there.
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665097
    m_Localized: I got it at last.
    m_Metadata:
      m_Items: []
  - m_Id: 18489064665099
    m_Localized: Why did you bring me to that hospital? Where are we really?
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859392
    m_Localized: "I didn\uFFFDt take you anywhere, my dear."
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859393
    m_Localized: You asked me to retrieve a relic. What does this plush have to do
      with anything?
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859394
    m_Localized: "\uFFFD"
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859395
    m_Localized: Answer.
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859396
    m_Localized: Everything in due time, petal.
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859397
    m_Localized: "\uFFFD"
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859399
    m_Localized: There is a doll there.
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859408
    m_Localized: "Painkillers. I\uFFFDll take them just in case."
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859412
    m_Localized: A dragon. It evokes a warm sensation, like home.
    m_Metadata:
      m_Items: []
  - m_Id: 18489068859413
    m_Localized: A siren. Reminds me of the fountain in the yard.
    m_Metadata:
      m_Items: []
  - m_Id: 18489073053696
    m_Localized: I wish I could be sleeping under a tree right now...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
