--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueStrings_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: bcc276741de44c348bb12478772571ae, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10359278445637632
    m_Localized: "Este pasillo est\xE1 muy oscuro. Ah\uFFFD no me meto."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746497
    m_Localized: "\xA1Partida guardada con \xE9xito!"
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746499
    m_Localized: "Est\xE1 cerrada."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746500
    m_Localized: "\xA1Abierta!"
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746501
    m_Localized: Necesita una llave.
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746503
    m_Localized: "Esta pared est\xE1 hecha una pena. Podr\uFFFDa tirarla de un soplo."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746504
    m_Localized: "\xA1Se ha roto!"
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746506
    m_Localized: "Ah\xED hay un martillo."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746507
    m_Localized: "Por fin me hago con \xE9l."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278512746509
    m_Localized: "\xA1Por qu\xE9 me has llevado a ese hospital? \uFFFDD\uFFFDnde
      estamos realmente?"
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135104
    m_Localized: "Yo no te he llevado a ning\xFAn sitio, bichito."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135105
    m_Localized: "Pero me dijiste que ten\xEDa que recuperar una reliquia. \xBFQu\xE9
      tiene que ver con este peluche?"
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135106
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135107
    m_Localized: Responde.
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135108
    m_Localized: Todo a su debido tiempo, petalito.
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135111
    m_Localized: "Una mu\xF1eca. Quiz\xE1 me sirva m\xE1s adelante."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135120
    m_Localized: "Analg\xE9sicos. Me los llevo por si acaso."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135124
    m_Localized: "Vaya, un drag\xF3n. Me transmite una sensaci\uFFFDn c\uFFFDlida,
      como de hogar."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135125
    m_Localized: "Una sirena\uFFFD Me recuerda a la fuente del patio."
    m_Metadata:
      m_Items: []
  - m_Id: 10359278521135126
    m_Localized: "Ay, ojal\uFFFD estar descansando a la sombrita de un \uFFFDrbol."
    m_Metadata:
      m_Items: []
  - m_Id: 10409242026684421
    m_Localized: "Una gata con su due\uFFFDa. Pone \uFFFDMenta y yo\uFFFD."
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903936
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903950
    m_Localized: "Ji ji ji. . . Y as\xED llega otra alma perdida."
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903951
    m_Localized: "\xBFD\xF3nde...estoy?"
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903952
    m_Localized: "Si lo supiera no estar\xEDa atrapada aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903953
    m_Localized: "Bueno, \xBFy qu\xE9 hago ahora?"
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903954
    m_Localized: "\xBFQu\xE9 me voy a encontrar?"
    m_Metadata:
      m_Items: []
  - m_Id: 11801796980903955
    m_Localized: "No lo s\xE9. Podr\xEDas empezar por esa puerta roja de ah\xED atr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 11804110248611843
    m_Localized: "Ya ver\xE1s..."
    m_Metadata:
      m_Items: []
  - m_Id: 12248224654716934
    m_Localized: . . . Rattrisha
    m_Metadata:
      m_Items: []
  - m_Id: 12248224654716936
    m_Localized: "Podr\xEDa salir un rato ahora que es de noche."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
