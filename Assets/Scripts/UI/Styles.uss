#Carrusel 
{
    flex-direction: row; 
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}
.carrusel-item
 {
    width: 100px;
    height: 100px;
    margin: 0 10px;
    transition-duration: 0.2s;
    flex-shrink: 0;
    margin-left: 15%;
    margin-right: 15%;
}
.carrusel-item-selected 
{
    scale: 3.3; 
    border-width: 3px;
    border-color: yellow;
    opacity: 1;
}
.carrusel-item-unselected 
{
    scale: 1.3; 
    opacity: 0.5;
}