                <ui:VisualElement name="ECGContainer" style="flex-grow: 1; -unity-background-image-tint-color: rgba(255, 255, 83, 0); background-color: rgba(255, 255, 255, 0); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); color: rgb(27, 27, 27);"/>
