            <ui:VisualElement name="CamaraContainer" style="flex-grow: 1; align-self: stretch; align-items: stretch; background-color: rgba(39, 28, 137, 0); width: auto; justify-content: flex-start; opacity: 1; margin-right: 0; background-image: url(&quot;project://database/Assets/UI%20Elements/camara-retro-vintage-aislada-fondo.png?fileID=2800000&amp;guid=805f13b6cd11ccb429426a189941a0b4&amp;type=3#camara-retro-vintage-aislada-fondo&quot;); background-size: 150% 150%; max-width: 300px;"/>
