    <ui:VisualElement name="MainContainer" class="Styles" style="flex-grow: 1; flex-direction: column; background-color: rgba(24, 21, 21, 0.76); background-image: url(&quot;project://database/Assets/UI%20Elements/360_F_184640234_wz0yGglOLBLWraF07A86Wnpadmrs28lo.jpg?fileID=2800000&amp;guid=ef2daac8cbc9f1347861289fec0341b6&amp;type=3#360_F_184640234_wz0yGglOLBLWraF07A86Wnpadmrs28lo&quot;); -unity-background-image-tint-color: rgb(101, 99, 99); position: relative; align-items: stretch; align-content: flex-start;">
        <ui:VisualElement name="TopContainer" style="flex-grow: 1; align-items: stretch; flex-direction: row; align-self: stretch; justify-content: space-between; height: auto; align-content: flex-start; margin-right: 0; margin-left: 0;">
