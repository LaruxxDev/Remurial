                <ui:Label text="Titulo" name="ItemName" style="flex-wrap: wrap; align-items: flex-start; height: auto; font-size: 60px; white-space: normal; width: auto; flex-direction: row; top: auto; -unity-font-style: bold; color: rgb(250, 247, 247); -unity-font-definition: url(&quot;project://database/Assets/Fonts/SpecialElite-Regular.ttf?fileID=12800000&amp;guid=68ec92f8606f6fb4b93869346679d119&amp;type=3#SpecialElite-Regular&quot;); -unity-text-align: middle-center; justify-content: center; align-self: center;"/>
